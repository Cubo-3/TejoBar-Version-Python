# Django Configuration
DJANGO_SECRET_KEY=tu_secret_key_de_django_aqui

# Database Configuration (MySQL/MariaDB)
MYSQLDATABASE=tejobar_db
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLHOST=localhost
MYSQLPORT=3306

# MercadoPago Credentials (Obtén tus credenciales desde el panel de desarrolladores de MercadoPago)
# Enlace: https://www.mercadopago.com.co/developers/panel
MERCADOPAGO_ACCESS_TOKEN=APP_USR-XXXXXX-XXXXXX-XXXXXXXX-XXXXXX
MERCADOPAGO_PUBLIC_KEY=APP_USR-XXXXXX-XXXXXX-XXXXXX

# Gmail SMTP Email Configuration (Opcional, para envío de notificaciones por correo)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_contrasena_de_aplicacion_gmail

